GROQ_API_KEY=
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Sign in with GitHub — create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/auth/github/callback (local) or https://<your-api>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Optional: your GitHub username; repos indexed before sign-in existed are given to you
ADMIN_GITHUB_LOGIN=
